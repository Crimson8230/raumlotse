# Copy to untracked .env and replace every placeholder before starting Compose.
POSTGRES_PASSWORD=<unique-local-database-password>
PGADMIN_DEFAULT_EMAIL=<your-email>
PGADMIN_DEFAULT_PASSWORD=<unique-local-pgadmin-password>

# Generate once; keep stable across restarts. Base64 of at least 32 random bytes.
AUTH_ATTEMPT_HMAC_KEY=<stable-base64-encoded-32-byte-secret>

# Local HTTP only. Set true behind HTTPS outside this local Compose setup.
SESSION_COOKIE_SECURE=false

# Optional local-only account provisioning. Enable only for a disposable local DB.
SPRING_PROFILES_ACTIVE=
AUTH_FIXTURE_EMAIL=
AUTH_FIXTURE_DISPLAY_NAME=
AUTH_FIXTURE_PASSWORD=

# Local mail is captured by Mailpit (http://localhost:8025).
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@raumlotse.local
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_CONNECTION_TIMEOUT=5s
MAIL_READ_TIMEOUT=5s
MAIL_WRITE_TIMEOUT=5s
MAIL_CONNECTION_TIMEOUT_MS=5000
MAIL_READ_TIMEOUT_MS=5000
MAIL_WRITE_TIMEOUT_MS=5000
MAIL_POLL_DELAY=1s
MAIL_BATCH_SIZE=20
MAIL_STALE_THRESHOLD=30s
